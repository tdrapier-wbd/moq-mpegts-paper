+/// Diagnostic override of the interleave hold budget (#4613), in milliseconds.
+fn diag_hold() -> Option<Duration> {
+	static HOLD: std::sync::OnceLock<Option<Duration>> = std::sync::OnceLock::new();
+	*HOLD.get_or_init(|| {
+		std::env::var("MOQ_TS_HOLD_MS")
+			.ok()
+			.and_then(|v| v.parse().ok())
+			.map(Duration::from_millis)
+	})
+}
